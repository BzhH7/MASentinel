    {
      "id": "R1",
      "type": "requirement",
      "description": "Planning Phase: Planner must produce a plan based on user request and save it via write_settled_plan when manager says 'sounds good'."
    },
    {
      "id": "R2",
      "type": "requirement",
      "description": "Iteration Phase: Coder must produce only code blocks, no extra text, and output is saved via write_latest_iteration."
    },
    {
      "id": "R3",
      "type": "requirement",
      "description": "Iteration Phase: Reviewer must evaluate code and produce comments, saved via write_latest_iteration_comments."
    },
    {
      "id": "R4",
      "type": "requirement",
      "description": "Context Management: Only latest script and comments are presented to agents in each iteration."
    },
    {
      "id": "R5",
      "type": "requirement",
      "description": "Project Continuation: System must detect existing projects and allow user to continue or start new."
    },
    {
      "id": "R6",
      "type": "requirement",
      "description": "Manual Speaker Control: AndyTools.py must override GroupChat/GroupChatManager to allow manual control of speakers."
    },
    {
      "id": "R7",
      "type": "requirement",
      "description": "Termination: User must terminate program externally; no in-app exit mechanism."
    }
