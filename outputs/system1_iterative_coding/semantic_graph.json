      "id": "R1",
      "type": "requirement",
      "description": "Planner must produce a plan containing numbered functional requirements and wait for manager approval ('sounds good') before calling write_settled_plan."
    },
    {
      "id": "R2",
      "type": "requirement",
      "description": "Coder must output only well-formatted code blocks, no extra text, and must not participate in conversation."
    },
    {
      "id": "R3",
      "type": "requirement",
      "description": "Reviewer must evaluate code against the planoro produce a list of criticisms/comments without writing code."
    },
    {
      "id": "R4",
      "type": "requirement",
      "description": "Manager must be able to test code and provide feedback to Coder or Reviewer before exiting conversation."
    },
    {
      "id": "R5",
      "type": "requirement",
      "description": "Iteration phase must present only the latest script and latest comments to Coder and Reviewer."
    },
    {
      "id": "R6",
      "type": "requirement",
      "description": "Encoding write_latest_iteration must save code to script_v{n}.py and write_settled_plan must save plan to project folder."
    },
    {
      "id": "R7",
      "type": "requirement",
      "description": "Encoding program must support continuing an existing project by loading planigin latest script and comments."
    },
    {
      "id": "R8",
      "type": "requirement",
      "description": "Encoding iteration loop must terminate only when user is satisfied; no automatic termination after fixed number of iterations."
    }
