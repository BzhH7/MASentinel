      "function_name": "write_settled_plan"
    },
    {
      "id": "R1",
      "type": "requirement",
      "description": "The system must implement a two-phase workflow: a planning phase that produces a written project plan, and an iterative coding phase that cycles through Coder and Reviewer until the user terminates the program."
    },
    {
      "id": "R2",
      "type": "requirement",
      "description": "Manager agent must be decorated with the write_latest_iteration and write_settled_plan tools so it can execute tool calls on behalf of other agents."
    },
    {
      "id": "R3",
      "type": "requirement",
      "description": "Planner must call write_settled_plan after manager approval and must not alter the plan afterward."
    },
    {
      "id": "R4",
      "type": "requirement",
      "description": "Coder must output only well-formed Python code blocks, without extra conversational text."
    },
    {
      "id": "R5",
      "type": "requirement",
      "description": "Reviewer must produce a textual evaluation and list of criticisms, without generating code."
    },
    {
      "id": "R6",
      "type": "requirement",
      "description": "The system must support resuming an existing project by loading the latest plan, script, and comments from the project folder."
    },
    {
      "id": "R7",
      "type": "requirement",
      "description": "During the iteration phase, the manager must be able to provide ad-hoc feedback to the Coder/Reviewer before typing 'exit' to finalize the current turn and move to the next agent."
    },
    {
      "id": "R8",
      "type": "requirement",
      "description": "The system must persist script files as script_v<n>.py and comment files as comments_v<n>.txt, incrementing the version number with each iteration."
    },
    {
      "id": "R9",
      "type": "requirement",
      "description": "Only the latest script and comment files are presented to agents at the start of each chat, preventing distraction from outdated versions."
    }
  ],
