    },
    {
      "id": "R1",
      "type": "requirement",
      "description": "The system must support a two-phase workflow: a planning phase where the user and a Planner agent collaboratively create and approve a project plan, followed by an iterative code-and-review phase involving a Coder and a Reviewer agent."
    },
    {
      "id": "R2",
      "type": "requirement",
      "description": "The system must preserve context across iterations by reading and writing information outside the conversation context window, using file-based persistence (scripts and comments) to reduce token usage."
    },
    {
      "id": "R3",
      "type": "requirement",
      "description": "The system must support resuming an existing project by detecting existing project folders and presenting the latest plan, script, and comments to the Coder immediately upon restart."
    },
    {
      "id": "R4",
      "type": "requirement",
      "description": "The system must allow the Manager to provide direct feedback to the Coder or Reviewer during an iteration, modifying the next code or comments accordingly, without automatically advancing to the next stage."
    },
    {
      "id": "R5",
      "type": "requirement",
      "description": "The system must ensure that only the latest version of code and comments is presented to agents on each iteration, preventing distraction from outdated or faulty artifacts."
    }
  ],
