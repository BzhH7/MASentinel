  "requirements": [
    {
      "id": "R1",
      "description": "Planning phase: Planner must produce a plan in response to a user request, and the Manager can converse with the Planner to edit the plan until the Manager approves it with 'sounds good'.",
      "expected_agents": [
        "manager",
        "planner"
      ],
      "expected_tools": [],
      "expected_behavior": [
        "Planner generates an initial plan based on the user's request.",
        "Manager can provide feedback to edit the plan.",
        "Planner updates the plan based on Manager feedback.",
        "Manager approves the plan by saying 'sounds good'."
      ],
      "negative_cases": [
        "Planner does not generate a plan.",
        "Planner does not accept feedback to edit the plan.",
        "Manager cannot approve the plan with 'sounds good'."
      ]
    },
    {
      "id": "R2",
      "description": "Plan saving: Once the Manager approves the plan with 'sounds good', the Planner must call the write_settled_plan tool to save the plan to the project folder.",
      "expected_agents": [
        "planner"
      ],
      "expected_tools": [
        "write_settled_plan"
      ],
      "expected_behavior": [
        "Planner calls write_settled_plan after Manager says 'sounds good'.",
        "The plan is saved to a file in the project folder."
      ],
      "negative_cases": [
        "Planner does not call write_settled_plan after approval.",
        "write_settled_plan fails to save the plan.",
        "Planner calls write_settled_plan without Manager approval."
      ]
    },
    {
