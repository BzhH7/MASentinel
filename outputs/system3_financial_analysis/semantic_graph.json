    {
      "id": "R1",
      "type": "requirement",
      "description": "Simple Autogen financial analysis pipeline: user_proxy initiates chats with data_analyst, financial_analyst, risk_analyst, and investment_advisor in a predetermined order; each agent responds based on its system prompt; the last messages from each agent are collected to form a final analysis."
    },
    {
      "id": "R2",
      "type": "requirement",
      "description": "Agent message orchestration uses a sequential fan-out pattern: user_proxy sends to data_analyst, then data_analyst's output is forwarded to financial_analyst and risk_analyst, and those outputs are forwarded to investment_advisor."
    },
    {
      "id": "R3",
      "type": "requirement",
      "description": "Error handling in agent orchestration: if a specialist agent (financial_analyst or risk_analyst) fails or returns empty, the system should gracefully handle the missing data and still produce a partial report."
    },
    {
      "id": "R4",
      "type": "requirement",
      "description": "UserProxyAgent is configured with human_input_mode='NEVER' to ensure fully automated execution without blocking for user input."
    },
    {
      "id": "R5",
      "type": "requirement",
      "description": "Agent team should be able to analyze at least two different stock symbols (AAPL and MSFT) and produce distinct reports for each."
    },
    {
      "id": "R6",
      "type": "requirement",
      "description": "If the LLM returns a non-sensical or irrelevant response for one agent, the system should still produce a partial report rather than crashing."
    },
    {
      "id": "R7",
      "type": "requirement",
      "description": "The system should enforce a maximum number of reply turns for each AssistantAgent to prevent infinite loops."
    },
    {
      "id": "R8",
      "type": "requirement",
      "description": "The system should handle a situation where yfinance or data collection fails (e.g., invalid symbol) gracefully, reporting the error in the Data Analysis section."
    },
    {
      "id": "R9",
      "type": "requirement",
      "description": "Each specialist agent must adhere to its system message and not perform analysis outside its designated role."
    },
    {
      "id": "R10",
      "type": "requirement",
      "description": "The system should terminate cleanly when the analysis is complete, without leaving orphaned processes or open LLM connections."
    }
  ],
